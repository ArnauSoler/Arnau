---
import { locales, pagePath, type Locale, type PageKey } from '../i18n';
import '../styles/global.css';

interface Props {
	locale: Locale;
	page: PageKey;
	meta: {
		title: string;
		description: string;
		ogTitle: string;
		ogDescription: string;
	};
}

const { locale, page, meta } = Astro.props;
const site = Astro.site ?? new URL('https://arnausoler.cat');
const canonicalUrl = new URL(pagePath(locale, page), site);
const ogLocales: Record<Locale, string> = {
	en: 'en_US',
	ca: 'ca_ES',
	es: 'es_ES',
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={meta.description} />
		<meta name="theme-color" content="#12304a" />
		<meta property="og:title" content={meta.ogTitle} />
		<meta property="og:description" content={meta.ogDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={ogLocales[locale]} />
		<link rel="canonical" href={canonicalUrl} />
		{
			locales.map((alternateLocale) => (
				<link
					rel="alternate"
					hreflang={alternateLocale}
					href={new URL(pagePath(alternateLocale, page), site)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={new URL(pagePath('en', page), site)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{meta.title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
