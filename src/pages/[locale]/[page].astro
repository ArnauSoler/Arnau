---
import type { GetStaticPaths } from 'astro';
import PortfolioPage from '../../components/PortfolioPage.astro';
import { detailPages, isDetailPage, isLocale, localizedLocales, type Locale } from '../../i18n';

export const getStaticPaths = (() =>
	localizedLocales.flatMap((locale) =>
		detailPages.map((page) => ({
			params: { locale, page },
			props: { locale, page },
		})),
	)) satisfies GetStaticPaths;

const routeLocale = Astro.params.locale;
const routePage = Astro.params.page;
if (!isLocale(routeLocale) || !isDetailPage(routePage)) {
	throw new Error('Unsupported route');
}

const locale = Astro.props.locale as Locale;
const page = Astro.props.page as 'software' | 'competing' | 'judging';
---

<PortfolioPage locale={locale} page={page} />
